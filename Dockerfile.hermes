FROM nousresearch/hermes-agent:latest

RUN mkdir -p /opt/hermes/render-assets/gmail-send

COPY --chmod=644 hermes-skills/gmail-send/SKILL.md /opt/hermes/render-assets/gmail-send/SKILL.md
COPY --chmod=755 hermes-skills/gmail-send/send_email.py /opt/hermes/render-assets/gmail-send/send_email.py
COPY --chmod=755 render_codex_auth.py /opt/hermes/render_codex_auth.py
COPY --chmod=755 render_codex_secret_init.sh /etc/cont-init.d/012-render-codex-auth

RUN printf 'model:\n  default: gpt-5.6-sol\n  provider: openai-codex\n' > /opt/hermes/render-config.yaml

ENV HERMES_INFERENCE_PROVIDER=openai-codex
ENV HERMES_INFERENCE_MODEL=gpt-5.6-sol

CMD ["sh", "-c", "cp /opt/hermes/render-config.yaml /opt/data/config.yaml && mkdir -p /opt/data/skills/gmail-send && cp /opt/hermes/render-assets/gmail-send/SKILL.md /opt/data/skills/gmail-send/SKILL.md && cp /opt/hermes/render-assets/gmail-send/send_email.py /opt/data/skills/gmail-send/send_email.py && chmod 755 /opt/data/skills/gmail-send/send_email.py && /opt/hermes/.venv/bin/python /opt/hermes/render_codex_auth.py && exec /opt/hermes/.venv/bin/hermes gateway run"]
