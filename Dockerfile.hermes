FROM nousresearch/hermes-agent:latest

COPY --chmod=644 hermes-skills/gmail-send/SKILL.md /opt/data/skills/gmail-send/SKILL.md
COPY --chmod=755 hermes-skills/gmail-send/send_email.py /opt/data/skills/gmail-send/send_email.py

# Use the ChatGPT/Codex subscription route instead of paid API billing.
RUN printf 'model:\n  default: gpt-5.6-sol\n  provider: openai-codex\n' > /opt/data/config.yaml \
    && chown 10000:10000 /opt/data/config.yaml \
    && chmod 600 /opt/data/config.yaml

ENV HERMES_INFERENCE_PROVIDER=openai-codex
ENV HERMES_INFERENCE_MODEL=gpt-5.6-sol

# Render secret files are mounted at /etc/secrets at runtime.
# If auth.json is present there, copy it into Hermes' home before starting.
CMD ["sh", "-c", "if [ -f /etc/secrets/auth.json ]; then cp /etc/secrets/auth.json /opt/data/auth.json && chmod 600 /opt/data/auth.json; fi; exec /opt/hermes/.venv/bin/hermes gateway run"]
